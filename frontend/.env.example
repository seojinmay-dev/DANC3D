# Vite development/preview proxy target
DANC3D_API_TARGET=http://127.0.0.1:8000
# Optional production API base; defaults to /api. Cross-origin URLs need CORS.
# VITE_API_BASE_URL=https://your-backend.example

# Optional direct WS base. Default: current ws/wss host + /ws (Vite WS proxy).
# VITE_WS_BASE_URL=ws://localhost:8000/ws
# Backend default allows http://localhost:5173 and http://127.0.0.1:5173.
# Dev/preview use strict port 5173. An intentional port override also needs
# its exact Origin in the backend's DANC3D_CORS_ORIGINS setting.
